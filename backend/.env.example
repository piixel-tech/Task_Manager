# MongoDB Atlas connection string (mongodb+srv://...). MONGO_URL also works as the name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=task_manager

# Auth
JWT_SECRET=change-me-long-random-string

# Used by scripts/seed.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# File uploads (relative paths resolve from backend/)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# development | production (dev-only routes are disabled in production)
ENVIRONMENT=development

# Timezone used to decide what "today" is for daily status
TIMEZONE=Asia/Kolkata

# Daily task reminders (APScheduler)
SCHEDULER_ENABLED=true
REMINDER_HOUR=9

# --- Web Push: notifications even when Task Manager is closed. Leave empty to switch it off ---
# Generate the pair once with:  python -m scripts.generate_vapid   (keep the private key secret; changing it drops every subscription)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services (mailto: or https URL)
VAPID_SUBJECT=mailto:admin@example.com

# --- Google (Calendar, Meet, Drive, Docs, Sheets) under Settings > Connected apps. Full setup: backend/README.md ---
# Missing keys are logged as warnings at startup, and the Connect button stays off ("Google not configured for <company>").
#
# Encrypts the saved Google tokens. Generate once and keep it safe (losing it forces everyone to reconnect):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_FERNET_KEY=
#
# Keys are per company: GOOGLE_<COMPANY NAME IN UPPER CASE>_*, with one Google Cloud project per company. Never shared.
# All three are needed for a company; with any one missing, that company's people cannot connect.
#   CLIENT_ID     console.cloud.google.com > APIs & Services > Credentials > Create credentials > OAuth client ID
#                 (type: Web application). Looks like 123-abc.apps.googleusercontent.com
#   CLIENT_SECRET shown in the same OAuth client (Client secret).
#   API_KEY       Credentials > Create credentials > API key (restrict it to the Calendar and Drive APIs).
# Also enable "Google Calendar API" and "Google Drive API" under APIs & Services > Library, and set up the
# OAuth consent screen (Internal for one Workspace, otherwise External and publish it to "In production").
GOOGLE_PIIXEL_CLIENT_ID=
GOOGLE_PIIXEL_CLIENT_SECRET=
GOOGLE_PIIXEL_API_KEY=
GOOGLE_UNWORK_CLIENT_ID=
GOOGLE_UNWORK_CLIENT_SECRET=
GOOGLE_UNWORK_API_KEY=
# Where Google sends the browser after consent. Must match, character for character, an "Authorized redirect URI"
# on each company's OAuth client. In production use your public HTTPS API address.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
# Browser origin of the frontend: used for CORS and the OAuth return redirect (no trailing slash)
FRONTEND_URL=http://localhost:5173
# Optional extra CORS origins as a JSON list, e.g. ["https://app.example.com"]
# CORS_ORIGINS=[]
GOOGLE_SYNC_MINUTES=5
# Push notifications need a public HTTPS URL for this API; leave off for local development.
GOOGLE_PUSH_ENABLED=false
PUBLIC_BASE_URL=
