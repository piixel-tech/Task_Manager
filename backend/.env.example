# MongoDB Atlas connection string (mongodb+srv://...)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=task_manager

# Auth
JWT_SECRET=change-me-long-random-string

# Used by scripts/seed.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# File uploads (relative paths resolve from backend/)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# development | production (dev-only routes are disabled in production)
ENVIRONMENT=development

# Timezone used to decide what "today" is for daily status
TIMEZONE=Asia/Kolkata

# Daily task reminders (APScheduler)
SCHEDULER_ENABLED=true
REMINDER_HOUR=9

# --- Google Calendar (Settings > Connected apps). Setup steps: backend/README.md ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_FERNET_KEY=
# Google keys are per company (the company name in upper case): never shared, never a fallback for each other.
GOOGLE_PIIXEL_CLIENT_ID=
GOOGLE_PIIXEL_CLIENT_SECRET=
GOOGLE_PIIXEL_API_KEY=
GOOGLE_UNWORK_CLIENT_ID=
GOOGLE_UNWORK_CLIENT_SECRET=
GOOGLE_UNWORK_API_KEY=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
FRONTEND_URL=http://localhost:5173
GOOGLE_SYNC_MINUTES=5
# Push notifications need a public HTTPS URL for this API; leave off for local development.
GOOGLE_PUSH_ENABLED=false
PUBLIC_BASE_URL=
